{
  "id": 6,
  "name": "Manual tests vs real reminders across Pi sessions",
  "category": "ui",
  "scenarios": [
    "out of boundary: session starts in daytime",
    "manual: future date reminds",
    "manual dedup: same date",
    "real reminder not blocked by manual test",
    "manual dedup carried to new session",
    "real dedup carried to new session",
    "standalone reset clears real dedup",
    "standalone reset clears manual dedup"
  ],
  "steps": [
    {
      "scenario": "out of boundary: session starts in daytime",
      "check": "new Pi session at 2026-10-09 14:00",
      "expected": "silent",
      "actual": "silent",
      "pass": true
    },
    {
      "scenario": "manual: future date reminds",
      "check": "/bedtime-test 2026-10-10 03:00",
      "expected": "popup",
      "actual": "popup",
      "pass": true
    },
    {
      "scenario": "manual dedup: same date",
      "check": "/bedtime-test 2026-10-10 03:30",
      "expected": "silent",
      "actual": "silent",
      "pass": true
    },
    {
      "scenario": "real reminder not blocked by manual test",
      "check": "new Pi session at 2026-10-10 02:00",
      "expected": "popup",
      "actual": "popup",
      "pass": true
    },
    {
      "scenario": "manual dedup carried to new session",
      "check": "/bedtime-test 2026-10-10 03:30",
      "expected": "silent",
      "actual": "silent",
      "pass": true
    },
    {
      "scenario": "real dedup carried to new session",
      "check": "new Pi session at 2026-10-10 02:30",
      "expected": "silent",
      "actual": "silent",
      "pass": true
    },
    {
      "scenario": "standalone reset clears real dedup",
      "check": "/bedtime-test reset, then new Pi session at 2026-10-10 02:45",
      "expected": "popup",
      "actual": "popup",
      "pass": true
    },
    {
      "scenario": "standalone reset clears manual dedup",
      "check": "/bedtime-test 2026-10-10 03:30",
      "expected": "popup",
      "actual": "popup",
      "pass": true
    }
  ],
  "pass": true
}
